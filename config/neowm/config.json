{
  "appearance": {
    "border_width": 2,
    "snap_distance": 16,
    "gap_size": 10,
    "icon_size": 16,
    "icon_spacing": 5,
    "fonts": [
      "Symbols Nerd Font Mono:size=12",
      "mononoki Nerd Font:size=12"
    ],
    "dmenu_font": "mononoki Nerd Font:size=12",
    "bar": {
      "enable": true,
      "top": true,
      "padding_vertical": 8,
      "padding_horizontal": 4,
      "border_width": 2,
      "border_color": "#cc241d",
      "status_separator": "|",
      "systray": {
        "enable": true,
        "pinning": 0,
        "icon_size": 16,
        "padding_vertical": 3,
        "padding_horizontal": 8,
        "pinning_fail_first": true,
        "separator": "|"
      }
    },
    "padding": {
      "vertical": 10,
      "horizontal": 10
    }
  },

  "theme": {
    "normal": {
      "foreground": "#d5c4a1",
      "background": "#1d2021",
      "border": "#32302f",
      "foreground_opacity": 1.0,
      "background_opacity": 0.90,
      "border_opacity": 1.0
    },
    "selected": {
      "foreground": "#fbf1c7",
      "background": "#cc241d",
      "border": "#cc241d",
      "foreground_opacity": 1.0,
      "background_opacity": 0.96,
      "border_opacity": 1.0
    }
  },

  "behavior": {
    "right_master": false,
    "scroll_sensitivity": 30,
    "autostart_script": "$XDG_CONFIG_HOME/neowm/scripts/autostart",
    "resize_hints": true,
    "master_factor": 0.5,
    "master_count": 1,
    "lock_fullscreen": true,
    "refresh_rate": 120,
    "smart_gaps": false
  },

  "tags": [
    "", "󰙨", "󰖟", "󰭹", "󱡭", "󰕧", "󰏘", "󰈙", "󰊖"
  ],

  "monocles": [
    "󰎤", "󰎧", "󰎪", "󰎭", "󰎱", "󰎳", "󰎶", "󰎹", "󰎼", "󰎿"
  ],

  "status_blocks": [
    { "name": "clock", "command": "$XDG_CONFIG_HOME/neowm/scripts/block_clock", "interval": 60 },
    { "name": "wifi", "command": "$XDG_CONFIG_HOME/neowm/scripts/block_wifi", "interval": 20 },
    { "name": "layout", "command": "$XDG_CONFIG_HOME/neowm/scripts/block_layout", "interval": 0 },
    { "name": "battery", "command": "$XDG_CONFIG_HOME/neowm/scripts/block_battery", "interval": 10 },
    { "name": "brightness", "command": "$XDG_CONFIG_HOME/neowm/scripts/block_brightness", "interval": 0 },
    { "name": "volume", "command": "$XDG_CONFIG_HOME/neowm/scripts/block_volume", "interval": 0 }
  ],

  "scratchpads": [
    { "name": "sptrm", "class": "sptrm", "command": "st -n sptrm -c sptrm -g 140x35" },
    { "name": "sptop", "class": "sptop", "command": "st -n sptop -c sptop -g 140x35 -e btop" },
    { "name": "sppmx", "class": "sppmx", "command": "st -n sppmx -c sppmx -g 140x35 -e pulsemixer" },
    { "name": "spflm", "class": "spflm", "command": "st -n spflm -c spflm -g 140x35 -e yazi" },
    { "name": "spmus", "class": "spmus", "command": "st -n spmus -c spmus -g 140x35 -e cmus" },
    { "name": "spsub", "class": "spsub", "command": "st -n spsub -c spsub -g 140x35 -e SubTUI" },
    { "name": "spani", "class": "spani", "command": "st -n spani -c spani -g 140x35 -e ani-cli" },
    { "name": "spyou", "class": "spyou", "command": "st -n spyou -c spyou -g 140x35 -e youtube-tui" },
    { "name": "spbit", "class": "Bitwarden", "command": "flatpak run com.bitwarden.desktop" },
    { "name": "spqal", "class": "Qalculate-gtk", "command": "flatpak run io.github.Qalculate" },
    { "name": "spscr", "class": "Arandr", "command": "arandr" }
  ],

  "rules": [
    { "class": "Galculator|Blueman-manager|Gpick|Kruler|Tor Browser|Wpa_gui|veromix|xtightvncviewer|Nextcloud|snx-rs-gui|Stoken-gui", "floating": true },
    { "class": "gnome-builder|lunarvim|Emacs|Godot|nvim|neovim|neovide", "tag": 1 },
    { "class": "Virt-manager|Org.gnome.Boxes", "tag": 2 },
    { "class": "LibreWolf|libreWolf|librewolf|librewolf-default|firefox|Firefox|Luakit|qutebrowser|Chromium|Brave-browser|thunderbird-esr", "tag": 3 },
    { "class": "Signal|Ferdium|ZapZap|Revolt|Element", "tag": 4 },
    { "class": "Audacity|Tenacity|Ardour|Carla2|Carla2-Control|qpwgraph|Cadence|easyeffects|kid3|flacon|FFaudioConverter", "tag": 5 },
    { "class": "QjackCtl|lsp-plugins", "tag": 5, "floating": true },
    { "class": "kdenlive|Pitivi|Natron|SimpleScreenRecorder|Ghb|mpv|^obs$", "tag": 6 },
    { "class": "Blender|Gimp-2.10|krita|Inkscape|Xournalpp|Com.github.xournalpp.xournalpp", "tag": 7 },
    { "class": "ONLYOFFICE Desktop Editors|libreoffice-.*|soffice|Joplin|obsidian|Notesnook|com.github.johnfactotum.Foliate", "tag": 8 },
    { "class": "steam|airshipper|pyrogenesis|DarkPlaces|xonotic-sdl|supertuxkart-sdl|supertux2|Minetest|openttd|warzone2100|wesnoth|retroarch|pcsx2-qt|duckstation-qt|Cemu|xemu|org.ppsspp.PPSSPP|dolphin-emu|es-de", "tag": 9 }
  ],

  "layouts": [
    { "symbol": "", "arrange": "tile" },
    { "symbol": "", "arrange": "floating" },
    { "symbol": "", "arrange": "monocle" },
    { "symbol": "", "arrange": "centeredmaster" },
    { "symbol": "", "arrange": "centeredfloatingmaster" },
    { "symbol": "", "arrange": "spiral" },
    { "symbol": "", "arrange": "dwindle" },
    { "symbol": "󰝘", "arrange": "grid" }
  ],

  "keybinds": [
    { "keys": ["Mod4+Return"], "action": "spawn", "argument": "st" },
    { "keys": ["Mod4+p", "r"], "action": "spawn", "argument": "dmenu_run -fn 'mononoki Nerd Font:size=12' -nb '#1d2021' -nf '#d5c4a1' -sb '#cc241d' -sf '#fbf1c7'" },
    { "keys": ["Mod4+p", "d"], "action": "spawn", "argument": "$XDG_SOURCE_HOME/dmenu/scripts/dmenu_drun" },
    { "keys": ["Mod4+p", "i"], "action": "spawn", "argument": "$XDG_SOURCE_HOME/dmenu/scripts/dmenu_wifi" },
    { "keys": ["Mod4+p", "s"], "action": "spawn", "argument": "$XDG_SOURCE_HOME/dmenu/scripts/dmenu_scrot" },
    { "keys": ["Mod4+p", "w"], "action": "spawn", "argument": "$XDG_SOURCE_HOME/dmenu/scripts/dmenu_wall" },
    { "keys": ["Mod4+p", "o"], "action": "spawn", "argument": "$XDG_SOURCE_HOME/dmenu/scripts/dmenu_open" },
    { "keys": ["Mod4+p", "e"], "action": "spawn", "argument": "$XDG_SOURCE_HOME/dmenu/scripts/dmenu_emoji" },
    { "keys": ["Mod4+p", "b"], "action": "spawn", "argument": "$XDG_SOURCE_HOME/dmenu/scripts/dmenu_blue" },
    { "keys": ["Mod4+p", "q"], "action": "spawn", "argument": "$XDG_SOURCE_HOME/dmenu/scripts/dmenu_power" },
    { "keys": ["Mod4+p", "c"], "action": "spawn", "argument": "clipmenu" },
    { "keys": ["Mod4+a", "e"], "action": "spawn", "argument": "st -n nvim -c nvim -e nvim" },
    { "keys": ["Mod4+a", "v"], "action": "spawn", "argument": "virt-manager" },
    { "keys": ["Mod4+a", "w"], "action": "spawn", "argument": "firefox" },
    { "keys": ["Mod4+a", "c"], "action": "spawn", "argument": "flatpak run org.signal.Signal" },
    { "keys": ["Mod4+a", "f"], "action": "spawn", "argument": "flatpak run org.ferdium.Ferdium" },
    { "keys": ["Mod4+a", "o"], "action": "spawn", "argument": "flatpak run org.onlyoffice.desktopeditors" },
    { "keys": ["Mod4+a", "n"], "action": "spawn", "argument": "flatpak run md.obsidian.Obsidian" },
    { "keys": ["Mod4+a", "g"], "action": "spawn", "argument": "flatpak run net.lutris.Lutris" },
    { "keys": ["Mod4+k"], "action": "spawn", "argument": "$XDG_CONFIG_HOME/neowm/scripts/kbd_layout && neowm -u layout" },
    { "keys": ["XF86AudioRaiseVolume"], "action": "spawn", "argument": "pamixer -i 5 && neowm -u volume" },
    { "keys": ["XF86AudioLowerVolume"], "action": "spawn", "argument": "pamixer -d 5 && neowm -u volume" },
    { "keys": ["XF86AudioMute"], "action": "spawn", "argument": "pamixer -t && neowm -u volume" },
    { "keys": ["XF86AudioMicMute"], "action": "spawn", "argument": "pamixer --default-source -t && neowm -u volume" },
    { "keys": ["XF86MonBrightnessUp"], "action": "spawn", "argument": "brightnessctl s 5%+ && neowm -u brightness" },
    { "keys": ["XF86MonBrightnessDown"], "action": "spawn", "argument": "brightnessctl s 5%- && neowm -u brightness" },
    { "keys": ["XF86AudioPause"], "action": "spawn", "argument": "playerctl play-pause" },
    { "keys": ["XF86AudioPlay"], "action": "spawn", "argument": "playerctl play-pause" },
    { "keys": ["XF86AudioNext"], "action": "spawn", "argument": "playerctl next" },
    { "keys": ["XF86AudioPrev"], "action": "spawn", "argument": "playerctl previous" },
    { "keys": ["XF86AudioStop"], "action": "spawn", "argument": "playerctl stop" },
    { "keys": ["Mod4+j"], "action": "focusstack", "argument": 1 },
    { "keys": ["Mod4+k"], "action": "focusstack", "argument": -1 },
    { "keys": ["Mod4+Shift+j"], "action": "movestack", "argument": -1 },
    { "keys": ["Mod4+Shift+k"], "action": "movestack", "argument": 1 },
    { "keys": ["Mod4+i"], "action": "incnmaster", "argument": 1 },
    { "keys": ["Mod4+d"], "action": "incnmaster", "argument": -1 },
    { "keys": ["Mod4+h"], "action": "setmfact", "argument": -0.05 },
    { "keys": ["Mod4+l"], "action": "setmfact", "argument": 0.05 },
    { "keys": ["Mod4+Control+Return"], "action": "zoom" },
    { "keys": ["Mod4+Shift+Return"], "action": "focusmaster" },
    { "keys": ["Mod4+Mod1+Return"], "action": "togglemaster" },
    { "keys": ["Mod4+Shift+Tab"], "action": "togglesticky" },
    { "keys": ["Mod4+Tab"], "action": "view" },
    { "keys": ["Mod4+q"], "action": "killclient" },
    { "keys": ["Mod4+c", "t"], "action": "setlayout", "argument": 0 },
    { "keys": ["Mod4+c", "f"], "action": "setlayout", "argument": 1 },
    { "keys": ["Mod4+c", "m"], "action": "setlayout", "argument": 2 },
    { "keys": ["Mod4+c", "c"], "action": "setlayout", "argument": 3 },
    { "keys": ["Mod4+c", "v"], "action": "setlayout", "argument": 4 },
    { "keys": ["Mod4+c", "s"], "action": "setlayout", "argument": 5 },
    { "keys": ["Mod4+c", "d"], "action": "setlayout", "argument": 6 },
    { "keys": ["Mod4+c", "g"], "action": "setlayout", "argument": 7 },
    { "keys": ["Mod4+Shift+space"], "action": "setlayout" },
    { "keys": ["Mod4+space"], "action": "cyclelayout", "argument": -1 },
    { "keys": ["Mod4+Control+space"], "action": "cyclelayout", "argument": 1 },
    { "keys": ["Mod4+f"], "action": "fullscreen" },
    { "keys": ["Mod4+Mod1+space"], "action": "togglefloating" },
    { "keys": ["Mod4+0"], "action": "view", "argument": "all" },
    { "keys": ["Mod4+Shift+0"], "action": "tag", "argument": "all" },
    { "keys": ["Mod4+comma"], "action": "focusmon", "argument": 1 },
    { "keys": ["Mod4+period"], "action": "focusmon", "argument": -1 },
    { "keys": ["Mod4+Shift+comma"], "action": "tagmon", "argument": 1 },
    { "keys": ["Mod4+Shift+period"], "action": "tagmon", "argument": -1 },
    { "keys": ["Mod4+b"], "action": "togglebar" },
    { "keys": ["Mod4+s", "Return"], "action": "togglescratch", "argument": "sptrm" },
    { "keys": ["Mod4+s", "b"], "action": "togglescratch", "argument": "sptop" },
    { "keys": ["Mod4+s", "p"], "action": "togglescratch", "argument": "sppmx" },
    { "keys": ["Mod4+s", "f"], "action": "togglescratch", "argument": "spflm" },
    { "keys": ["Mod4+s", "m"], "action": "togglescratch", "argument": "spmus" },
    { "keys": ["Mod4+s", "n"], "action": "togglescratch", "argument": "spsub" },
    { "keys": ["Mod4+s", "a"], "action": "togglescratch", "argument": "spani" },
    { "keys": ["Mod4+s", "y"], "action": "togglescratch", "argument": "spyou" },
    { "keys": ["Mod4+s", "k"], "action": "togglescratch", "argument": "spbit" },
    { "keys": ["Mod4+s", "c"], "action": "togglescratch", "argument": "spqal" },
    { "keys": ["Mod4+s", "d"], "action": "togglescratch", "argument": "spscr" },
    { "keys": ["Mod4+Control+Shift+q"], "action": "quit" },
    { "keys": ["Mod4+Control+r"], "action": "restart" },
    { "keys": ["Mod4+Right"], "action": "viewnext" },
    { "keys": ["Mod4+Left"], "action": "viewprev" },
    { "keys": ["Mod4+Shift+Right"], "action": "tagtonext" },
    { "keys": ["Mod4+Shift+Left"], "action": "tagtoprev" },
    { "keys": ["Mod4+1"], "action": "comboview", "argument": 1 },
    { "keys": ["Mod4+2"], "action": "comboview", "argument": 2 },
    { "keys": ["Mod4+3"], "action": "comboview", "argument": 3 },
    { "keys": ["Mod4+4"], "action": "comboview", "argument": 4 },
    { "keys": ["Mod4+5"], "action": "comboview", "argument": 5 },
    { "keys": ["Mod4+6"], "action": "comboview", "argument": 6 },
    { "keys": ["Mod4+7"], "action": "comboview", "argument": 7 },
    { "keys": ["Mod4+8"], "action": "comboview", "argument": 8 },
    { "keys": ["Mod4+9"], "action": "comboview", "argument": 9 },
    { "keys": ["Mod4+Control+1"], "action": "toggleview", "argument": 1 },
    { "keys": ["Mod4+Control+2"], "action": "toggleview", "argument": 2 },
    { "keys": ["Mod4+Control+3"], "action": "toggleview", "argument": 3 },
    { "keys": ["Mod4+Control+4"], "action": "toggleview", "argument": 4 },
    { "keys": ["Mod4+Control+5"], "action": "toggleview", "argument": 5 },
    { "keys": ["Mod4+Control+6"], "action": "toggleview", "argument": 6 },
    { "keys": ["Mod4+Control+7"], "action": "toggleview", "argument": 7 },
    { "keys": ["Mod4+Control+8"], "action": "toggleview", "argument": 8 },
    { "keys": ["Mod4+Control+9"], "action": "toggleview", "argument": 9 },
    { "keys": ["Mod4+Shift+1"], "action": "combotag", "argument": 1 },
    { "keys": ["Mod4+Shift+2"], "action": "combotag", "argument": 2 },
    { "keys": ["Mod4+Shift+3"], "action": "combotag", "argument": 3 },
    { "keys": ["Mod4+Shift+4"], "action": "combotag", "argument": 4 },
    { "keys": ["Mod4+Shift+5"], "action": "combotag", "argument": 5 },
    { "keys": ["Mod4+Shift+6"], "action": "combotag", "argument": 6 },
    { "keys": ["Mod4+Shift+7"], "action": "combotag", "argument": 7 },
    { "keys": ["Mod4+Shift+8"], "action": "combotag", "argument": 8 },
    { "keys": ["Mod4+Shift+9"], "action": "combotag", "argument": 9 },
    { "keys": ["Mod4+Control+Shift+1"], "action": "toggletag", "argument": 1 },
    { "keys": ["Mod4+Control+Shift+2"], "action": "toggletag", "argument": 2 },
    { "keys": ["Mod4+Control+Shift+3"], "action": "toggletag", "argument": 3 },
    { "keys": ["Mod4+Control+Shift+4"], "action": "toggletag", "argument": 4 },
    { "keys": ["Mod4+Control+Shift+5"], "action": "toggletag", "argument": 5 },
    { "keys": ["Mod4+Control+Shift+6"], "action": "toggletag", "argument": 6 },
    { "keys": ["Mod4+Control+Shift+7"], "action": "toggletag", "argument": 7 },
    { "keys": ["Mod4+Control+Shift+8"], "action": "toggletag", "argument": 8 },
    { "keys": ["Mod4+Control+Shift+9"], "action": "toggletag", "argument": 9 }
  ],

  "buttons": [
    { "click": "ClkLtSymbol", "button": 1, "action": "setlayout", "argument": 0 },
    { "click": "ClkLtSymbol", "button": 3, "action": "setlayout", "argument": 2 },
    { "click": "ClkWinTitle", "button": 2, "action": "zoom" },
    { "click": "ClkStatusText", "button": 2, "action": "spawn", "argument": "st" },
    { "click": "ClkClientWin", "modifiers": "Mod4", "button": 1, "action": "moveorplace", "argument": 1 },
    { "click": "ClkClientWin", "modifiers": "Mod4", "button": 2, "action": "togglefloating" },
    { "click": "ClkClientWin", "modifiers": "Mod4", "button": 3, "action": "resizemouse" },
    { "click": "ClkClientWin", "modifiers": "Mod4", "button": 4, "action": "resizemousescroll", "argument": 0 },
    { "click": "ClkClientWin", "modifiers": "Mod4", "button": 5, "action": "resizemousescroll", "argument": 1 },
    { "click": "ClkClientWin", "modifiers": "Mod4", "button": 6, "action": "resizemousescroll", "argument": 2 },
    { "click": "ClkClientWin", "modifiers": "Mod4", "button": 7, "action": "resizemousescroll", "argument": 3 },
    { "click": "ClkTagBar", "button": 1, "action": "view" },
    { "click": "ClkTagBar", "button": 3, "action": "toggleview" },
    { "click": "ClkTagBar", "modifiers": "Mod4", "button": 1, "action": "tag" },
    { "click": "ClkTagBar", "modifiers": "Mod4", "button": 3, "action": "toggletag" }
  ]
}
