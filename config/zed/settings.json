// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
    // don't prompt for updates
    "auto_update": false,

    // editor settings
    "autosave": "on_focus_change",
    "confirm_quit": true,
    "tab_size": 4,
    "ui_font_size": 16,
    "buffer_font_size": 16,
    "soft_wrap": "editor_width",
    "hard_tabs": false,
    "vim_mode": true,
    "search": {
        "regex": true // allow regex search
    },

    // specific languages settings
    "languages": {
        "Dart": {
            "tab_size": 2
        },
        "LaTeX": {
            "tab_size": 2
        },
        "JSON": {
            "tab_size": 2
        }
    },

    // theme settings
    "theme": {
        "mode": "dark",
        "light": "Gruvbox Dark Hard",
        "dark": "Gruvbox Dark Hard"
    },

    // transparency settings
    "experimental.theme_overrides": {
        "background.appearance": "blurred",
        "background": "#1d2021BB",
        "editor.background": "#1d2021BB",
        "editor.gutter.background": "#1d2021BB",
        "toolbar.background": "#1d2021BB",
        "editor.line_highlight": "#1d2021BB",
        "editor.active_line.background": "#1d2021BB",
        "editor.selection.background": "#1d2021BB",
        "editor.selection.foreground": "#1d2021BB",
        "editor.selection.border": "#1d2021BB",
        "editor.selection.inactive.foreground": "#1d2021BB",
        "editor.selection.inactive.border": "#1d2021BB",
        "editor.selection.active.background": "#1d2021BB",
        "editor.selection.active.foreground": "#1d2021BB",
        "editor.selection.active.border": "#1d2021BB",
        "editor.selection.inactive.background": "#1d2021BB"
    },

    // terminal settings
    "terminal": {
        "shell": {
            "program": "fish"
        },
        "blinking": "on"
    },

    // configure tabs UI
    "tabs": {
        "close_position": "right",
        "file_icons": true,
        "git_status": true
    },

    // settings for project panel and outline panel
    "project_panel": {
        "button": true,
        "default_width": 300,
        "dock": "left",
        "indent_size": 10
    },
    "outline_panel": {
        "button": true,
        "default_width": 200,
        "dock": "right",
        "indent_size": 15
    },

    // ai stuff
    "agent": {
        "default_model": {
            "provider": "copilot_chat",
            "model": "o4-mini"
        },
        "button": true,
        "version": "2"
    },
    "features": {
        "copilot": true,
        "edit_prediction_provider": "copilot"
    },

    // disable panels I don't need
    "chat_panel": {
        "button": "never"
    },
    "collaboration_panel": {
        "button": false
    },

    // disable telemetry
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "lsp": {
        "tinymist": {
            "settings": {
                "exportPdf": "onSave",
                "outputPath": "$root/$name"
            }
        }
    }
}
