profile triple {
    output eDP-1
    output HDMI-A-2
    output DP-1
    exec hyprctl keyword monitor eDP-1, preferred, 3200x0, 1
    exec hyprctl keyword monitor DP-1, higherr, 0x0, 1
    exec hyprctl keyword monitor HDMI-A-2, higherr, 1280x0, 1
}

profile hdmi {
    output eDP-1
    output HDMI-A-2
    exec hyprctl keyword monitor eDP-1, prefferred, 0x0, 1
    exec hyprctl keyword monitor HDMI-A-2, preferred, auto, 1, mirror, eDP-1
}

profile work {
    output eDP-1
    output "Dell Inc. DELL P2423DE B1LPWY3"
    exec hyprctl keyword monitor eDP-1, preferred, 0x0, 1
    exec hyprctl keyword monitor DP-1, preferred, 1920x0, 1
}

profile hdmi-c {
    output eDP-1
    output DP-1
    exec hyprctl keyword monitor eDP-1, prefferred, 0x0, 1
    exec hyprctl keyword monitor DP-1, preferred, auto, 1, mirror, eDP-1
}

profile laptop {
    output eDP-1
    exec hyprctl keyword monitor eDP-1, prefferred, 0x0, 1
}
