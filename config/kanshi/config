profile triple {
    output eDP-1
    output DP-1
    output DP-3
    exec hyprctl keyword monitor eDP-1, preferred, 0x0, 1
    exec hyprctl keyword monitor DP-3, 1920x1080@100.00, 1920x0, 1
    exec hyprctl keyword monitor DP-1, 1280x1024@75.03, 3840x0, 1
}

profile hdmi {
    output eDP-1
    output HDMI-A-2
    exec hyprctl keyword monitor eDP-1, prefferred, 0x0, 1
    exec hyprctl keyword monitor HDMI-A-2, preferred, auto, 1, mirror, eDP-1
}

profile work {
    output eDP-1
    output "Dell Inc. DELL P2423DE B1LPWY3"
    exec hyprctl keyword monitor eDP-1, preferred, 0x0, 1
    exec hyprctl keyword monitor DP-1, preferred, 1920x0, 1
}

profile hdmi-c {
    output eDP-1
    output DP-1
    exec hyprctl keyword monitor eDP-1, prefferred, 0x0, 1
    exec hyprctl keyword monitor DP-1, preferred, auto, 1, mirror, eDP-1
}

profile laptop {
    output eDP-1
    exec hyprctl keyword monitor eDP-1, prefferred, 0x0, 1
}
