profile triple {
    exec pgrep wl-mirror && pkill -n wl-mirror
    output eDP-1 position 0,0
    output DP-4 mode 1920x1080@100Hz position 1920,0
    output DP-1 mode 1280x1024@75Hz position 3840,0
}

profile triple-2 {
    exec pgrep wl-mirror && pkill -n wl-mirror
    output eDP-1 position 0,0
    output DP-3 mode 1920x1080@100Hz position 1920,0
    output DP-1 mode 1280x1024@75Hz position 3840,0
}

profile work {
    exec pgrep wl-mirror && pkill -n wl-mirror
    output eDP-1 position 0,455
    output DP-4 position 1920,455
    output DP-5 position 3840,0 transform 90
}

profile work-2 {
    exec pgrep wl-mirror && pkill -n wl-mirror
    output eDP-1 position 0,455
    output DP-3 position 1920,455
    output DP-4 position 3840,0 transform 90
}

profile hdmi {
    exec pgrep wl-mirror && pkill -n wl-mirror
    output eDP-1 position 0,0
    output HDMI-A-2 position 1920,0
    exec wl-present mirror eDP-1 --fullscreen-output HDMI-A-2 --fullscreen
}

profile hdmi-c {
    exec pgrep wl-mirror && pkill -n wl-mirror
    output eDP-1 position 0,0
    output DP-1 position 1920,0
    exec wl-present mirror eDP-1 --fullscreen-output DP-1 --fullscreen
}

profile laptop {
    exec pgrep wl-mirror && pkill -n wl-mirror
    output eDP-1 position 0,0
}
