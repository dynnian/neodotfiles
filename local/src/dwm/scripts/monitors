#!/bin/bash

# Grab monitor status (varies with the machine)
monitor1=$(cat /sys/class/drm/card1-HDMI-A-2/status)
monitor2=$(cat /sys/class/drm/card1-DP-1/status)

# Function to extract monitor name from EDID
get_monitor_name() {
    # Extract monitor name from EDID using hexdump and strings
    edid_file="/sys/class/drm/card1-DP-1/edid"
    if [ -f "$edid_file" ]; then
        strings "$edid_file" | grep -m1 -oE "[a-zA-Z0-9 -_]{8,}"
    else
        echo ""
    fi
}

# Check for work monitor
work_monitor_name="DELL P2423DE" # Your identified monitor name
connected_monitor_name=$(get_monitor_name)

# If both monitors are connected
if [ "$monitor1" = "connected" ] && [ "$monitor2" = "connected" ]; then
    xrandr --output eDP1 --mode 1920x1080 --pos 3200x0 --rotate normal \
           --output DP1 --mode 1280x1024 --pos 0x0 --rate 75.02 --rotate normal \
           --output HDMI2 --primary --mode 1920x1080 --rate 100.00 --pos 1280x0 --rotate normal
# If only HDMI is connected
elif [ "$monitor1" = "connected" ]; then
    xrandr --output eDP1 --primary --auto \
           --output HDMI2 --auto --scale-from 1920x1080 --same-as eDP1
# If only DP is connected
elif [ "$monitor2" = "connected" ]; then
    # Check if it's the specific work monitor
    if [ "$connected_monitor_name" = "$work_monitor_name" ]; then
        # Custom dual monitor setup for the DELL P2423DE
        xrandr --output eDP1 --mode 1920x1080 --pos 0x0 --rotate normal \
               --output DP1 --primary --mode 2560x1440 --rate 59.95 --pos 1920x0
    else
        # Default mirroring setup
        xrandr --output eDP1 --primary --auto \
               --output DP1 --auto --scale-from 1920x1080 --same-as eDP1
    fi
else
    # Single internal monitor setup
    xrandr --output eDP1 --primary --auto
    sleep 1
    xrandr --output HDMI2 --off --output DP1 --off
fi
